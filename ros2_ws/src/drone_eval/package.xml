<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drone_eval</name>
  <version>0.1.0</version>
  <description>Evaluation for Drone SITL: records estimates next to simulator ground truth and computes accuracy metrics and plots (Python glue).</description>
  <maintainer email="koromo.tani.e@gmail.com">hirokiri</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
